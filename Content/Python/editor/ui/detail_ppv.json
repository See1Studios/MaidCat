{
  "TabLabel": "포스트 프로세스 프리셋",
  "InitTabSize": [250, 50],
  "InitTabPosition": [0, 0],
  "InitPyCmd": "import ui.detail_ppv, importlib; importlib.reload(ui.detail_ppv); detail_ppv = ui.detail_ppv.PPDetailWidget(%JsonPath)",
  "Root": {
    "SVerticalBox": {
      "Slots": [
        {
          "FillHeight": 0.5,
          "SHorizontalBox": {
            "Slots": [
              {
                "VAlign": "Bottom",
                "HAlign": "Left",
                "STextBlock": {
                  "Text": "Load Preset",
                  "TextStyle": {
                    "Style": "FEditorStyle",
                    "StyleName": "TinyText",
                    "Size": [10, 10]
                  }
                }
              },
              {
                "VAlign": "Bottom",
                "HAlign": "Left",
                "STextBlock": {
                  "Text": "Overwrite Preset",
                  "TextStyle": {
                    "Style": "FEditorStyle",
                    "StyleName": "TinyText",
                    "Size": [10, 10]
                  }
                }
              },
              {
                "STextBlock": {
                  "Text": ""
                }
              }
            ]
          }
        },
        {
          "SHorizontalBox": {
            "Slots": [
              {
                "Padding": [0, 4],
                "Column_Row": [1, 30],
                "SComboBox": {
                  "Aka": "CombBoxA",
                  "Content": {
                    "Text": "ComboBox"
                  },
                  "OptionsSource": [],
                  "OnSelectionChanged": "detail_ppv.on_load_clicked(%)"
                }
              },
              {
                "Padding": [0, 4],
                "Column_Row": [1, 30],
                "SComboBox": {
                  "Aka": "CombBoxB",
                  "Content": {
                    "Text": "ComboBox"
                  },
                  "OptionsSource": [],
                  "OnSelectionChanged": "detail_ppv.on_overwrite_clicked(%)"
                }
              },
              {
                "padding": 2,
                "AutoWidth": true,
                "SBox": {
                  "MinDesiredWidth": 20,
                  "Padding": [0, 4],
                  "Content": {
                    "SButton": {
                      "Text": "New",
                      "HAlign": "Center",
                      "VAlign": "Center",
                      "OnClick": "detail_ppv.on_new_clicked()"
                    }
                  }
                }
              },
              {
                "padding": 2,
                "AutoWidth": true,
                "SBox": {
                  "MinDesiredWidth": 20,
                  "Padding": [0, 4],
                  "Content": {
                    "SButton": {
                      "Text": "?",
                      "HAlign": "Center",
                      "VAlign": "Center",
                      "OnClick": "detail_ppv.on_new_clicked()"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
